# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Where limiter state lives: "memory" (single instance) or "redis" (distributed).
STORAGE_BACKEND=memory

# Only used when STORAGE_BACKEND=redis.
REDIS_URL=redis://localhost:6379/0

# Algorithm used when a request does not name one:
# token_bucket | sliding_window | fixed_window | leaky_bucket
DEFAULT_ALGORITHM=token_bucket

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# What to do when the storage backend is unreachable.
#   true  = fail open  (allow the request, flag it as degraded)
#   false = fail closed (answer 503 / deny)
FAIL_OPEN=true

# Redis connect/command timeout in seconds. Keep it small: a hung Redis
# should cost a request milliseconds, not seconds.
REDIS_SOCKET_TIMEOUT=0.25

# Redis connection pool size. Requests beyond it wait up to REDIS_SOCKET_TIMEOUT for a free
# connection before failing. Size it to your peak number of in-flight checks per instance.
REDIS_MAX_CONNECTIONS=100
